# Copy to contracts/.env (never commit .env)
# Sepolia RPC URL from Alchemy / Infura / any provider
SEPOLIA_RPC_URL=
# Private key of a THROWAWAY test wallet used only to deploy the factory. Never use a wallet holding real funds.
DEPLOYER_PRIVATE_KEY=
# Address (not key) of the platform administrator wallet. Becomes the admin of every escrow created by the factory.
ADMIN_ADDRESS=
ETHERSCAN_API_KEY=
