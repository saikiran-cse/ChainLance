# Copy to backend/.env for reference. Spring Boot does not read .env files itself:
# in PowerShell set these as environment variables before starting (see README), or put them in IntelliJ run settings.
DB_URL=jdbc:mysql://localhost:3306/chainlance?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=chainlance
DB_PASSWORD=saisagar
# At least 32 random characters
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional: creates the platform ADMIN login on first start
ADMIN_EMAIL=admin@chainlance.local
ADMIN_PASSWORD=
# Blockchain (read-only verification). Local Hardhat: CHAIN_ID=31337 and SEPOLIA_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=11155111
SEPOLIA_RPC_URL=
FACTORY_ADDRESS=
# Public address (NOT a private key) of the admin wallet that deployed the factory
ADMIN_WALLET_ADDRESS=
REQUIRED_CONFIRMATIONS=1
