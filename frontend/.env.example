# Copy to frontend/.env (or .env.local) for local development.
# IMPORTANT: every VITE_* variable is bundled into the browser build and is PUBLIC.
# Never put passwords, JWT secrets, private keys or private RPC credentials here.

# Base URL of the Spring Boot API (no trailing slash, no /api suffix).
VITE_API_BASE_URL=http://localhost:8080

# "false" = call the real backend only (default).
# "true"  = use clearly labelled sample data for marketplace pages whose backend endpoints are not built yet
#           (projects, proposals, negotiation, agreements). Authentication, profile and wallet always use the real API.
VITE_USE_MOCKS=false

# Chain the app expects MetaMask to be on. 11155111 = Ethereum Sepolia. Use 31337 for a local Hardhat node.
VITE_EXPECTED_CHAIN_ID=11155111
